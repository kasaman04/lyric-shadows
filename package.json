{
  "name": "lyric-shadows",
  "version": "1.0.0",
  "description": "English shadowing app using song lyrics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "voice:dev": "node scripts/serve-voice-practice.js",
    "test:voice": "node --test --test-concurrency=1 test/voice-practice*.test.cjs",
    "sentence:dev": "node scripts/serve-sentence-game.js",
    "test:sentence": "node --test test/sentence-game.test.cjs"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0"
  }
}
