    "duration": 6.8,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Once we've booked the flights, we can look for a hotel. Let's book tonight before the price goes up. I'll get my laptop.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
