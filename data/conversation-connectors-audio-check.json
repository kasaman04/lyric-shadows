    "duration": 5.28,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Do you want to watch something tonight? Sure. Once the baby's asleep. I'll find something short.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
    "id": "once-dialogue-09",
