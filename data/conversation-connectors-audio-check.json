    "duration": 7.28,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Do we really need to leave at seven? I'd like to leave early so that we don't have to rush. Fair enough. I'll set an alarm.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
