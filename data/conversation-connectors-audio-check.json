    "duration": 5.2,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Text me once you get there. I will. The train should take about an hour. Have a good trip.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
    "id": "once-dialogue-03",
