    "duration": 6.0,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Can we talk for a minute? Sure, I'll come over once I finish this email. Thanks, there's no rush.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
