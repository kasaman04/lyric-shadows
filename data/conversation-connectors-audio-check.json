    "duration": 7.68,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Once the water boils, turn the heat down. Okay, do I put the lid on too? Yes, but leave a small gap.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
