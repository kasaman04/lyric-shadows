    "duration": 4.56,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Are you getting those headphones? Yeah, once I get paid. Let me know how they sound.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
