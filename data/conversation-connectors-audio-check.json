    "duration": 7.68,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Keep your voice down so that we don't like the baby. Sorry, I didn't realize she was asleep. She only just nodded off.",
    "textSimilarity": 0.9778,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
