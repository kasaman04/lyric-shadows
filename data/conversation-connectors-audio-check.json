    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
    "id": "so-that-dialogue-02",
    "sourceHash": "e946bfbc5ef513480535f67a5c000018e8bcd96a4f287a06ad27b009b5f0b3da",
    "duration": 6.96,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Why did you take a photo of the menu? So that we can show Maya the vegetarian options. Good thinking. I'll send it to her.",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
    "id": "so-that-dialogue-03",
