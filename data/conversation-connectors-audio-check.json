    "sourceHash": "77730cf202f5accc589c232c298148e456239d8ea8d3d30de188d1f85479acf5",
    "duration": 5.52,
    "method": "offline-faster-whisper-base.en",
    "transcript": "Can I put these tools away? Yes, once you've wiped them down. Okay, where's the cloth?",
    "textSimilarity": 1.0,
    "targetExpressionHeard": true,
    "needsReview": false
  },
  {
